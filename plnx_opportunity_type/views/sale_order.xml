<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
    
        <record id="view_order_form_inherit_add_commission" model="ir.ui.view">
            <field name="name">sale.order.view.form.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='order_lines']" position="after">
                    <page name="commission" string="Commission">
                        <field name="commission_line_ids" readonly="1">
                            <tree string="Commission">
                                <field name="partner_id"/>
                                <field name="rate" widget="percentage"/>
                                <field name="amount"/>
                                <field name="order_id" column_invisible="1"/>
                            </tree>
                            <form string="Commission Line">
                                <sheet>
                                    <group>
                                        <field name="partner_id"/>
                                        <field name="rate" widget="percentage"/>
                                        <field name="amount"/>
                                        <field name="order_id" invisible="1"/>
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
    
    </data>
    
</odoo>