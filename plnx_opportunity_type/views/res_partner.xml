<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <record id="view_account_commission_line_tree_partner" model="ir.ui.view">
            <field name="name">account.commission.line.tree.partner</field>
            <field name="model">account.commission.line</field>
            <field name="arch" type="xml">
                <tree string="Commission Lines" create="0" edit="0">
                    <header>
                        <button name="action_register_payment"
                                string="Register Payment"
                                type="object"
                                class="btn-primary"/>
                    </header>
                    <field name="invoice_date" />
                    <field name="move_id"/>
                    <field name="rate" widget="percentage" column_invisible="1"/>
                    <field name="amount" sum="Total Amount" column_invisible="1"/>
                    <field name="amount_total" sum="Total"/>
                    <field name="commission_percentage" widget="percentage"/>
                    <field name="commission_amount" sum="Total Commission"/>
                    <field name="state" widget="badge"/>
                </tree>
            </field>
        </record>

        <record id="account_commission_line_view_search" model="ir.ui.view">
            <field name="model">account.commission.line</field>
            <field name="arch" type="xml">
                <search string="Commission Lines">
                    <group expand="0" string="Group By">
                        <filter name="date" date="date" context="{'group_by': 'invoice_date:quarter'}" string="Date"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_partner_commission_lines" model="ir.actions.act_window">
            <field name="name">Commission Lines</field>
            <field name="res_model">account.commission.line</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="plnx_opportunity_type.view_account_commission_line_tree_partner"/>
            <field name="search_view_id" ref="plnx_opportunity_type.account_commission_line_view_search"/>
            <field name="domain">[('partner_id', '=', active_id), ('move_id', '!=', False)]</field>
            <field name="context">{'default_partner_id': active_id, 'search_default_date': True}</field>
        </record>

        <record id="action_partner_account_payment" model="ir.actions.act_window">
            <field name="name">Payment with Commission</field>
            <field name="res_model">account.payment</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="account.view_account_payment_tree"/>
            <field name="domain">[('partner_id', '=', active_id), ('with_commission', '=', True), ('payment_type', '=', 'outbound')]</field>
            <field name="context">{'default_partner_id': active_id}</field>
        </record>
    
        <record id="view_partner_form_inherit_add_commission" model="ir.ui.view">
            <field name="name">res.partner.view.form.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group//group[2]" position="inside">
                    <field name="planned_target"/>
                    <field name="total_commission" readonly="1"/>
                </xpath>
                <div name="button_box" position="inside">
                    <button type="action"
                            name="%(plnx_opportunity_type.action_partner_commission_lines)d"
                            class="oe_stat_button"
                            icon="fa-money"
                            invisible="commission_count == 0">
                        <field name="commission_count" widget="statinfo" string="Commissions"/>
                    </button>
                    <button type="action"
                            name="%(plnx_opportunity_type.action_partner_account_payment)d"
                            class="oe_stat_button"
                            icon="fa-credit-card-alt"
                            invisible="loss_commission_count == 0">
                        <field name="loss_commission_count" widget="statinfo" string="Payments with Commission"/>
                    </button>
                </div>
            </field>
        </record>

    
    </data>
    
</odoo>